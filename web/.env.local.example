# ============================================================================
# Xhabe Safari Lodge — environment template
#
# Copy to `.env.local` (gitignored) and fill in the blanks. The same variables
# must also be set in the Vercel project settings for deployed builds.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase — project "Xhabe_Safari_Lodge" (ref zcdckolyrioxikdpcjui)
#
# Both values below are safe to expose in the browser. Find them under
# Project Settings → API Keys in the Supabase dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://zcdckolyrioxikdpcjui.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase service role — SECRET
#
# Bypasses Row Level Security, so it must never be exposed to the browser or
# committed. Used only inside route handlers (/api/bookings, /api/enquiries)
# to write guest submissions and read availability.
#
# Without this, availability checks and booking submission fail while the rest
# of the site keeps working. Copy it from
# Project Settings → API Keys → service_role.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Resend — transactional email
#
# If RESEND_API_KEY is unset, booking/enquiry emails are skipped with a logged
# warning and the request still succeeds — so local development works without
# email credentials.
#
# *** BOTH VARIABLES ARE REQUIRED FOR GUESTS TO RECEIVE ANYTHING. ***
#
# RESEND_FROM_EMAIL is not optional in production. Resend will only send from a
# domain you have verified; with this unset the code falls back to Resend's
# shared onboarding sender, which is allowed to deliver to the Resend account
# owner's own inbox and nobody else. Every other recipient — guest
# confirmations, the lodge's own notifications, confirm/decline notices from
# the admin page — is refused with a 403, and the booking saves with nobody
# told. The admin page shows a warning banner whenever the site is in that
# state.
#
# To fix, once:
#   1. resend.com/domains → Add Domain → xhabesafari.com (or a send. subdomain)
#   2. Add the DKIM/SPF records it gives you at the domain registrar
#   3. Wait for the domain to show "Verified"
#   4. Set RESEND_FROM_EMAIL below to an address on that domain, in both
#      .env.local and the Vercel project settings, then redeploy
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# RESEND_FROM_EMAIL="Xhabe Safari Lodge <reservations@send.xhabesafarilodge.com>"

# Development catch-all — leave unset in production.
#
# Until a sending domain is verified, Resend refuses every recipient except the
# account owner, which makes the guest confirmation impossible to review (it is
# addressed to somebody else by definition). Set this to the account owner's
# address and every message is delivered there instead, with its intended
# recipient shown in the subject and a banner in the body.
#
# Remove it once a domain is verified — it silently reroutes guest mail.
# RESEND_REDIRECT_TO=you@example.com

# ---------------------------------------------------------------------------
# Google Analytics (GA4) — optional
#
# The measurement ID from Google Analytics → Admin → Data Streams → your web
# stream, formatted "G-XXXXXXXXXX". Leave unset and no gtag.js script is
# rendered at all — the site works identically either way.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Google Search Console — optional
#
# The content value from Search Console → Settings → Ownership verification →
# HTML tag method (just the value, not the whole <meta> tag). Leave unset and
# no google-site-verification meta tag is rendered.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Admin area (/admin)
#
# Single shared password for lodge staff. Whoever holds it can confirm and
# decline bookings and read every guest's name, email, and phone number, so
# treat it as a real credential: long, random, and shared over something
# better than a text message.
#
# Leave unset to disable /admin entirely — the page refuses all access rather
# than falling open. Changing it immediately signs out every existing session.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
